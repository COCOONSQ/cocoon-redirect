<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>可可尼看板 - 正在连接...</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
    background: linear-gradient(135deg, #f5f7fa 0%, #e4ecf7 100%);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #2c3e50;
  }
  .card {
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 8px 30px rgba(0,0,0,0.08);
    padding: 40px 48px;
    max-width: 480px;
    width: 90%;
    text-align: center;
  }
  .logo {
    font-size: 22px;
    font-weight: 700;
    color: #c0392b;
    margin-bottom: 8px;
  }
  .subtitle {
    font-size: 14px;
    color: #7f8c8d;
    margin-bottom: 28px;
  }
  .spinner {
    width: 44px;
    height: 44px;
    border: 4px solid #e1e8f0;
    border-top-color: #c0392b;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin: 0 auto 20px;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .status {
    font-size: 15px;
    line-height: 1.6;
    min-height: 24px;
  }
  .url-box {
    margin-top: 18px;
    padding: 12px 14px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    font-size: 13px;
    word-break: break-all;
    color: #475569;
    display: none;
  }
  .manual-btn {
    display: none;
    margin-top: 18px;
    padding: 12px 24px;
    background: #c0392b;
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 15px;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
  }
  .err { color: #e74c3c; }
  .ok { color: #27ae60; }
  .small { font-size: 12px; color: #95a5a6; margin-top: 20px; }
</style>
</head>
<body>
<div class="card">
  <div class="logo">可可尼上新看板</div>
  <div class="subtitle">正在为您连接到实时数据...</div>
  <div class="spinner" id="spinner"></div>
  <div class="status" id="status">正在获取最新访问地址...</div>
  <div class="url-box" id="urlBox"></div>
  <a class="manual-btn" id="manualBtn" href="#" target="_blank">手动打开看板</a>
  <div class="small">地址由看板服务端自动维护，无需手动更新</div>
</div>

<script>
// 读取 GitHub Gist 中存放的最新 tunnel 地址
const GIST_RAW = 'https://gist.githubusercontent.com/COCOONSQ/0817ffdb36907b2b584b41eb59c8d156/raw/tunnel_url.txt';

const statusEl = document.getElementById('status');
const spinner = document.getElementById('spinner');
const urlBox = document.getElementById('urlBox');
const manualBtn = document.getElementById('manualBtn');

function showError(msg) {
  spinner.style.display = 'none';
  statusEl.innerHTML = '<span class="err">' + msg + '</span>';
}

function doRedirect(url) {
  // 清理地址（去除首尾空白、换行）
  url = url.trim();
  if (!url || url === 'INIT' || !/^https?:\/\//.test(url)) {
    showError('看板地址暂不可用，请稍后重试或联系管理员');
    return;
  }
  spinner.style.display = 'none';
  statusEl.innerHTML = '<span class="ok">已连接到看板，正在打开...</span>';
  urlBox.style.display = 'block';
  urlBox.textContent = url;
  manualBtn.style.display = 'inline-block';
  manualBtn.href = url;
  // 自动跳转
  setTimeout(function() { window.location.href = url; }, 800);
}

function fetchWithTimeout(url, ms) {
  return new Promise(function(resolve, reject) {
    const timer = setTimeout(function() { reject(new Error('timeout')); }, ms);
    fetch(url, { cache: 'no-store' }).then(function(r) {
      clearTimeout(timer);
      resolve(r);
    }).catch(function(e) {
      clearTimeout(timer);
      reject(e);
    });
  });
}

fetchWithTimeout(GIST_RAW, 8000).then(function(r) {
  return r.text();
}).then(function(text) {
  doRedirect(text);
}).catch(function(e) {
  showError('无法获取看板地址（网络问题），请刷新页面重试');
});
</script>
</body>
</html>
